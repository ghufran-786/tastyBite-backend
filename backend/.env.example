# Copy this file, rename the copy to ".env", and fill in your real values.
# Never upload the .env file (with real values) to GitHub — only this
# .env.example file (with placeholder text) is safe to upload.

# --- Firebase (Firestore) — order storage, orders persist permanently ---
# Paste your ENTIRE service account JSON here as ONE LINE (see README
# for exact steps to get this from the Firebase console).
# If left blank, the server falls back to a local orders.json file,
# which does NOT survive Render redeploys.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# --- Twilio (for sending real OTP SMS) ---
# Leave these as placeholders (or blank) to stay in DEMO OTP mode —
# any phone number + code "123456" will verify successfully, so you
# can keep testing the full order flow without real SMS. The moment
# you add real values here, demo mode turns off automatically.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# --- Server ---
PORT=4000

# --- Owner dashboard ---
# Any string you like - the owner enters this PIN on the dashboard page
# to view orders. Keep it private, share only with staff who need it.
OWNER_PIN=tastybites123

# NOTE: There is no payment gateway key needed. Customers pay via Cash
# on Delivery or UPI (opens their phone's UPI app directly — no fees,
# no gateway). Set your UPI ID directly in qr-restaurant-page.html
# (look for the UPI_ID constant near the top of the <script> section).

# Copy this file, rename the copy to ".env", and fill in your real values.
# Never upload the .env file (with real values) to GitHub — only this
# .env.example file (with placeholder text) is safe to upload.

# --- Twilio (for sending OTP SMS) ---
# Leave these as-is (or blank) until you're ready to enable real SMS.
# The server now runs fine without them — OTP just won't be sent until
# these are filled in with real values.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid
# ^ Create a "Verify Service" in Twilio console (Verify > Services).
#   It handles OTP generation, expiry, and retries for you - simpler
#   and more secure than rolling your own OTP storage.

# --- Razorpay ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- Server ---
PORT=4000

# --- Owner dashboard ---
# Any string you like - the owner enters this PIN on the dashboard page
# to view orders. Keep it private, share only with staff who need it.
OWNER_PIN=changeme123
